{
  "name": "@owngame/cli",
  "version": "0.12.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:release",
    "test:release": "npm run build && node --test tests/release/*.test.mjs",
    "verify:package": "node scripts/release/verify-package.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "prepack": "npm run build",
    "games:verify": "node scripts/games/verify.mjs",
    "games:build": "node scripts/games/build-all.mjs",
    "test:games": "node --test tests/games/*.test.mjs",
    "web:build": "node scripts/web/build.mjs",
    "web:publish": "node scripts/web/publish.mjs",
    "android:build": "node scripts/android/build.mjs",
    "android:check": "node scripts/android/export-source.mjs && node --test tests/android/public-source.test.mjs tests/mobile/*.test.mjs",
    "android:test:compile": "node scripts/android/test-repository.mjs --compile-only",
    "test:android": "node scripts/android/test-repository.mjs",
    "android:test:updates": "node scripts/android/test-updates.mjs",
    "ios:prepare": "node scripts/ios/prepare.mjs",
    "ios:build": "node scripts/ios/build.mjs",
    "ios:check": "node scripts/ios/export-source.mjs && node --test tests/ios/*.test.mjs tests/mobile/*.test.mjs",
    "test:ios": "node scripts/ios/test.mjs",
    "outline": "node apps/outline/server.mjs",
    "test:outline": "node --test tests/outline/*.test.mjs",
    "test:outline:gestures": "node scripts/outline/verify-gestures.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "bin": {
    "owngame": "dist/packages/cli/index.js",
    "owngame-mcp": "dist/packages/cli/index.js"
  },
  "description": "Game authoring toolkit for existing AI agents: skills, CLI, MCP and playable Web and Unity starters",
  "files": [
    "dist/packages/",
    "starter-knowledge/",
    "skills/",
    "templates/",
    "scripts/toolkit/",
    "docs/install.md",
    "docs/agent-setup.md",
    "docs/quickstart.md",
    "docs/resource-search.md",
    "docs/cases/",
    "docs/style-recipes.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "docs/images/",
    "docs/releasing.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/README.md",
    "docs/zh-CN/quickstart.md",
    "docs/remix.md",
    "docs/open-source-games.md",
    "docs/game-publishing.md",
    "apps/outline/",
    "docs/device-development.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "homepage": "https://owngame.dev",
  "keywords": [
    "game-development",
    "agent-skills",
    "mcp",
    "web-games",
    "owngame",
    "unity",
    "3d-games"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/luka2chat/owngame.git"
  },
  "bugs": {
    "url": "https://github.com/luka2chat/owngame/issues"
  }
}
